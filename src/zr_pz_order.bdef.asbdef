managed implementation in class zbp_r_pz_order unique;
strict ( 2 );
with draft;

define behavior for ZR_PZ_ORDER alias SalesOrder
persistent table zpz_order
draft table zpz_order_d
etag master LocalLastChangedAt
lock master total etag LastChangedAt
authorization master ( global )
{
  create;
  update;
  delete;
  association _Items { create; with draft; }

  field ( readonly, numbering : managed ) OrderUUID;
  field ( readonly ) Status, StatusCriticality, CancelReason, ItemsAmount, PlatformFees,
                     NetAmount, ItemCount, Currency,
                     LocalCreatedBy, LocalCreatedAt, LocalLastChangedBy,
                     LocalLastChangedAt, LastChangedAt;
  field ( mandatory ) Channel;

  action ( features : instance ) cancelOrder parameter ZD_PZ_CANCEL_REASON result [1] $self;
  internal action recalculateAmounts;

  determination setDefaults on modify { create; }
  determination calculateAmounts on modify { create; field Channel, StoreDiscount; }

  validation validateChannel on save { create; field Channel; }

  draft action Resume;
  draft action Edit;
  draft action Activate optimized;
  draft action Discard;

  draft determine action Prepare
  {
    validation validateChannel;
    validation SalesOrderItem~validateMenuItem;
    validation SalesOrderItem~validateQuantity;
  }

  side effects
  {
    field Channel affects field PlatformFees, field NetAmount;
    field StoreDiscount affects field NetAmount;
  }

  mapping for zpz_order
  {
    OrderUUID          = order_uuid;
    Channel            = channel;
    ExternalID         = external_id;
    OrderDateTime      = order_datetime;
    Status             = status;
    CancelReason       = cancel_reason;
    ItemsAmount        = items_amount;
    DeliveryFee        = delivery_fee;
    StoreDiscount      = store_discount;
    PlatformIncentive  = platform_incentive;
    PlatformFees       = platform_fees;
    NetAmount          = net_amount;
    Currency           = currency;
    ItemCount          = item_count;
    PaymentMethod      = payment_method;
    DeliveryType       = delivery_type;
    Rating             = rating;
    CustomerComment    = customer_comment;
    LocalCreatedBy     = local_created_by;
    LocalCreatedAt     = local_created_at;
    LocalLastChangedBy = local_last_changed_by;
    LocalLastChangedAt = local_last_changed_at;
    LastChangedAt      = last_changed_at;
  }
}

define behavior for ZR_PZ_ORDERITEM alias SalesOrderItem
persistent table zpz_order_item
draft table zpz_order_item_d
etag master LocalLastChangedAt
lock dependent by _Order
authorization dependent by _Order
{
  update;
  delete;
  association _Order { with draft; }

  field ( readonly, numbering : managed ) ItemUUID;
  field ( readonly ) OrderUUID, TotalAmount, Currency, LocalLastChangedAt;
  field ( mandatory ) MenuItemID, Quantity;

  determination setItemDefaults on modify { create; }
  determination calculateItemAmount on modify { create; delete; field MenuItemID, Quantity; }

  validation validateMenuItem on save { create; field MenuItemID; }
  validation validateQuantity on save { create; field Quantity; }

  // Any change to an item, including deleting it, changes the order totals
  side effects
  {
    field MenuItemID affects field TotalAmount;
    field Quantity affects field TotalAmount;
    $self affects entity _Order;
  }

  mapping for zpz_order_item
  {
    ItemUUID           = item_uuid;
    OrderUUID          = order_uuid;
    MenuItemID         = menu_item_id;
    Quantity           = quantity;
    TotalAmount        = total_amount;
    Currency           = currency;
    LocalLastChangedAt = local_last_changed_at;
  }
}