projection;
strict ( 2 );
use draft;
use side effects;

define behavior for ZC_PZ_ORDER alias SalesOrder
use etag
{
  use create;
  use update;
  use delete;

  use action cancelOrder;

  use action Resume;
  use action Edit;
  use action Activate;
  use action Discard;
  use action Prepare;

  use association _Items { create; with draft; }
}

define behavior for ZC_PZ_ORDERITEM alias SalesOrderItem
use etag
{
  use update;
  use delete;

  use association _Order { with draft; }
}